# Copy to .env.local for local dev (required when APP_URL points at *.algorycode.com).
# API_BASE_URL must match qr-service SERVER_PORT (default 8080 in application.yaml).
API_BASE_URL=http://localhost:8080
AUTH_BASE_URL=http://localhost:8080
PUBLIC_API_BASE_URL=http://localhost:8080
APP_URL=http://localhost:3001
APP_ENV=development

# Production (staff.algorycode.com) — auth and API must use the same qr-service host:
# APP_URL=https://staff.algorycode.com
# APP_ENV=production
# API_BASE_URL=https://prod.qrapi.algorycode.com
# AUTH_BASE_URL=https://prod.qrapi.algorycode.com
# PUBLIC_API_BASE_URL=https://prod.qrapi.algorycode.com
NEXT_PUBLIC_DASHBOARD_ORIGIN=http://localhost:3000
